{
  "name": "@aic/desktop",
  "productName": "AI Interview Copilot",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time interview answer suggestions grounded in your resume.",
  "author": "AI Interview Copilot",
  "homepage": "https://github.com/whiteangel-dev/AiInterviewCopilot",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p e2e/tsconfig.json",
    "test:e2e": "playwright test",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:dir": "electron-vite build && electron-builder --dir --publish never",
    "icon": "electron scripts/render-icon.mjs"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@aic/core": "*",
    "@aic/db": "*",
    "@aic/ipc": "*",
    "@aic/prompts": "*",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.67.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
