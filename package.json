{
  "name": "ai-interview-copilot",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "evals"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @aic/desktop",
    "build": "npm run build -w @aic/desktop",
    "dist:win": "npm run dist:win -w @aic/desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e -w @aic/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "db:generate": "npm run db:generate -w @aic/db",
    "eval:turns": "npm run turns -w @aic/evals",
    "eval:live": "npm run live -w @aic/evals"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": true,
    "electron-winstaller": false,
    "protobufjs": false,
    "@google/genai": false,
    "better-sqlite3-multiple-ciphers": false
  }
}
